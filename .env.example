# Supabase → Project Settings → Database → Connection string → URI.
# Use the "Transaction pooler" (port 6543) string: it is the one built for
# serverless. Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Comma-separated addresses that may see and use the admin controls
# (database status + the manual keep-alive button). Leave empty for nobody.
ADMIN_EMAILS=you@example.com

# Optional but recommended in production. Vercel Cron sends this as
# `Authorization: Bearer <value>`; when set, the cron endpoint rejects
# anything else. Use any long random string.
CRON_SECRET=
